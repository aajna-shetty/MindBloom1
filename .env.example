# MindBloom Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Database URL
# Defaults to local SQLite if unset. For PostgreSQL Docker container, use:
# DATABASE_URL=postgresql://postgres:aajna@localhost:5435/mindbloom
DATABASE_URL=sqlite:///./mindbloom.db

# Authentication & JWT Security
MINDBLOOM_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
MINDBLOOM_TOKEN_EXPIRE_SECONDS=86400
MINDBLOOM_PBKDF2_ITERATIONS=100000

# Video Pipeline Configuration
SESSION_DURATION_SECONDS=15
DEEPFACE_EVERY_N_FRAMES=15
VIDEO_FUSION_ALPHA_FLOOR=0.4
VIDEO_FUSION_ALPHA_CEILING=0.9

# Participant Biometric Verification
MINDBLOOM_VERIFY_SIMILARITY_THRESHOLD=0.65
MINDBLOOM_VERIFY_UNCERTAIN_THRESHOLD=0.48
